{
  "name": "live-dmx",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:front": "eslint .",
    "lint:back": "cd src-tauri && cargo clippy -- -D warnings",
    "lint": "bun lint:front && bun lint:back",
    "format:front": "prettier --check .",
    "format:front:fix": "prettier --write . && eslint --fix .",
    "format:back": "cd src-tauri && cargo fmt -- --check",
    "format:back:fix": "cd src-tauri && cargo fmt",
    "format": "bun format:front && bun format:back",
    "format:fix": "bun format:front:fix && bun format:back:fix",
    "test:front": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:back": "cd src-tauri && cargo test",
    "test": "bun run test:front && bun run test:back",
    "check": "bun run typecheck && bun run lint && bun run format && bun run test && bun run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@number-flow/vue": "^0.5.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@vueuse/core": "^14.3.0",
    "daisy-ui-kit": "^5.2.4",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "canvas": "^3.2.3",
    "daisyui": "^5.5.19",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.8.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.58.1",
    "vite": "8.0.16",
    "vitest": "^4.1.4",
    "vue-tsc": "^2.1.10"
  }
}
